{
  "name": "bloxvault",
  "version": "0.1.0",
  "private": true,
  "description": "Letterboxd + Play Later Vault + Hidden Gem Discovery Engine for Roblox games",
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "presetup": "node scripts/ensure-env.mjs",
    "setup": "npm run db:seed",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:fresh": "node scripts/reset-db.mjs",
    "db:reset": "node scripts/reset-db.mjs && npm run db:seed"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
